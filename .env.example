# 腾讯云 MySQL 8 连接地址：替换账号、密码、主机、端口和库名；密码中的特殊字符需 URL 编码。
DATABASE_URL=mysql+pymysql://jifen:CHANGE_ME@your-mysql-host:3306/jifen?charset=utf8mb4
# 浏览器访问地址，不带末尾斜杠；本地例如 http://localhost:5174，生产填写 HTTPS 地址。本地启动端口从此读取。
PUBLIC_URL=https://jifen.orvibo.com
# 会话签名密钥：自行生成至少 32 个字符的随机字符串，不要使用示例占位值。
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS

# 飞书开放平台「凭证与基础信息」中的企业自建应用 App ID。
FEISHU_APP_ID=
# 同一飞书应用的 App Secret，仅保存在服务端。
FEISHU_APP_SECRET=
# 本企业的 tenant_key，用于限制仅本企业员工登录。
FEISHU_TENANT_KEY=
# 飞书登录回调：PUBLIC_URL 加 /api/auth/callback，须与飞书后台登记的回调完全一致。
FEISHU_REDIRECT_URI=https://jifen.orvibo.com/api/auth/callback
# 初始管理员的飞书 user_id；多个用英文逗号分隔，仅初始化时授予权限，后续在系统中管理。
INITIAL_ADMIN_USER_IDS=

